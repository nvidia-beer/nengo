    "version": "0.2.0",
    "configurations": [
        {
            "name": "01 - Basic Ensemble",
            "type": "debugpy",
            "request": "launch",
            "program": "/usr/local/bin/nengo",
            "args": [
                "01_basic_ensemble.py",
                "-P", "8081",
                "-l", "*",
                "--unsecure",
                "-p", "nengo",
                "--no-browser"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
